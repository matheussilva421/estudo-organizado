# Ignore all by default and only allow project source set.
/*

!/.gitignore
!/.github/
!/.github/**
!/.githooks/
!/.githooks/**
!/.prettierignore
!/.aiexclude
!/.codexignore
!/.cursorignore
!/src/
!/src/**
!/scripts/
!/scripts/**
!/docs/
!/docs/**
!/README.md
!/README_DEV.md
!/AGENTS.md
!/CLAUDE.md
!/CHANGELOG.md
!/LICENSE
!/wrangler.jsonc
!/Abrir_Estudo_Organizado.bat
!/Abrir_Estudo_Organizado_Mock.bat
!/Abrir_Visual_Layout_Lab.bat
!/package.json
!/package-lock.json
!/vitest.config.js
!/playwright.config.js
!/eslint.config.js
!/tests/
!/tests/**

# Impeccable design context (read by design tooling and agents).
!/PRODUCT.md
!/DESIGN.md
!/.impeccable/
!/.impeccable/**

# Dependencies and generated artifacts. These are already ignored by the
# allowlist above, but are listed explicitly for humans and agents.
node_modules/
coverage/
playwright-report/
test-results/
dist/
build/
.cache/
.turbo/

# Local and agent artifacts.
.claude/worktrees/
.sisyphus/
.playwright-mcp/
_local_archive/
output/
.impeccable/live/sessions/

# Local secrets, logs, and databases.
*.log
*.sqlite
*.db
.env
.env.local

!src/js/firebase/firebase-config.js.example
src/js/firebase/firebase-config.js

# AI-HANDOFF:LOCAL-STATE:START
!/.ai/
!/.ai/README.md
!/.ai/PLAN.md
!/.ai/DECISIONS.md
!/.ai/history/
!/.ai/history/**
!/AGENTS.md
!/CLAUDE.md
.ai/CURRENT.md
.ai/RECOVERY.md
.ai/LOG.md
.ai/runtime/
!/.claude/
/.claude/*
!/.claude/settings.json
!/.codex/
/.codex/*
!/.codex/hooks.json
.ai-handoff-backups/
.ai-project-state.lock
.ai-transaction-*/
# AI-HANDOFF:LOCAL-STATE:END
