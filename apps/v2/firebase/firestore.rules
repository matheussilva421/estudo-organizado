rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validId(value) {
      return value is string && value.size() > 0 && value.size() <= 200;
    }

    function validPathId(value) {
      return validId(value) && !value.matches('/');
    }

    function validLibrary(value) {
      return value is string && value.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    function validEntityType(value) {
      return value == 'subject'
        || value == 'edital'
        || value == 'edital-discipline'
        || value == 'assunto'
        || value == 'aula'
        || value == 'lesson-topic-link'
        || value == 'planning-scenario'
        || value == 'plan-block'
        || value == 'study-session'
        || value == 'habit-occurrence'
        || value == 'review-topic'
        || value == 'review-policy'
        || value == 'review-commitment'
        || value == 'review-execution'
        || value == 'review-board-evidence'
        || value == 'review-match'
        || value == 'review-priority';
    }

    function validEnvelope(data) {
      return data.keys().hasOnly([
          'entityId', 'entityType', 'schemaVersion', 'revision', 'deleted',
          'payload', 'epoch', 'uid'
        ])
        && validPathId(data.entityId)
        && validEntityType(data.entityType)
        && data.schemaVersion is int
        && data.schemaVersion == 1
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 1000000000
        && data.deleted is bool
        && data.epoch is int
        && data.epoch >= 0
        && data.epoch <= 1000000000
        && data.uid is string
        && data.uid == request.auth.uid
        && (
          (data.deleted == true && data.payload == null)
          || (data.deleted == false && data.payload is map)
        );
    }

    function validOperation(data) {
      return data.keys().hasOnly([
          'operationId', 'entityId', 'payloadDigest', 'revision',
          'changeSequence', 'uid'
        ])
        && validPathId(data.operationId)
        && validPathId(data.entityId)
        && data.payloadDigest is string
        && data.payloadDigest.matches('^[a-fA-F0-9]{64}$')
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 1000000000
        && data.changeSequence is int
        && data.changeSequence >= 1
        && data.changeSequence <= 1000000000
        && data.uid is string
        && data.uid == request.auth.uid;
    }

    function validChange(data) {
      return data.keys().hasOnly([
          'sequence', 'entityId', 'revision', 'deleted', 'epoch', 'operationId', 'uid'
        ])
        && data.sequence is int
        && data.sequence >= 1
        && data.sequence <= 1000000000
        && validPathId(data.entityId)
        && validPathId(data.operationId)
        && data.revision is int
        && data.revision >= 1
        && data.revision <= 1000000000
        && data.deleted is bool
        && data.epoch is int
        && data.epoch >= 0
        && data.epoch <= 1000000000
        && data.uid is string
        && data.uid == request.auth.uid;
    }

    function validHead(data) {
      return data.keys().hasOnly(['epoch', 'changeSequence', 'uid'])
        && data.epoch is int
        && data.epoch >= 0
        && data.epoch <= 1000000000
        && data.changeSequence is int
        && data.changeSequence >= 0
        && data.changeSequence <= 1000000000
        && data.uid is string
        && data.uid == request.auth.uid;
    }

    match /users/{uid} {
      match /libraries/{remoteLibraryId} {
        allow read: if owns(uid) && validLibrary(remoteLibraryId);
        allow write: if false;

        function entityHasCausalAudit(entityId, data) {
          let headExists = exists(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/meta/head);
          let headAfterExists = existsAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/meta/head);
          let sequence = headAfterExists
            ? getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/meta/head).data.changeSequence
            : 0;
          let changeExists = exists(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(sequence)));
          let changeAfterExists = existsAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(sequence)));
          let operationId = changeAfterExists
            ? getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(sequence))).data.operationId
            : '';
          let operationExists = operationId != ''
            && exists(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/operations/$(operationId));
          let operationAfterExists = operationId != ''
            && existsAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/operations/$(operationId));
          return headAfterExists
            && (
              (headExists && sequence == get(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/meta/head).data.changeSequence + 1)
              || (!headExists && sequence == 1)
            )
            && changeAfterExists
            && !changeExists
            && operationAfterExists
            && !operationExists
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(sequence))).data.entityId == entityId
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(sequence))).data.revision == data.revision
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(sequence))).data.deleted == data.deleted
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(sequence))).data.epoch == data.epoch
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(sequence))).data.epoch == getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/meta/head).data.epoch
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/operations/$(operationId)).data.entityId == entityId
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/operations/$(operationId)).data.revision == data.revision
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/operations/$(operationId)).data.changeSequence == sequence
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/operations/$(operationId)).data.operationId == operationId;
        }

        match /entities/{entityId} {
          allow read: if owns(uid) && validLibrary(remoteLibraryId);
          allow create: if owns(uid)
            && validLibrary(remoteLibraryId)
            && entityId == request.resource.data.entityId
            && validEnvelope(request.resource.data)
            && request.resource.data.revision == 1
            && entityHasCausalAudit(entityId, request.resource.data);
          allow update: if owns(uid)
            && validLibrary(remoteLibraryId)
            && entityId == request.resource.data.entityId
            && validEnvelope(request.resource.data)
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.epoch == resource.data.epoch
            && request.resource.data.entityType == resource.data.entityType
            && entityHasCausalAudit(entityId, request.resource.data);
          allow delete: if false;
        }

        match /operations/{operationId} {
          allow read: if owns(uid) && validLibrary(remoteLibraryId);
          allow create: if owns(uid)
            && validLibrary(remoteLibraryId)
            && operationId == request.resource.data.operationId
            && validOperation(request.resource.data)
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId)).data.revision == request.resource.data.revision
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(request.resource.data.changeSequence))).data.entityId == request.resource.data.entityId
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(request.resource.data.changeSequence))).data.revision == request.resource.data.revision
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(request.resource.data.changeSequence))).data.deleted == getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId)).data.deleted
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId)).data.epoch == getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(request.resource.data.changeSequence))).data.epoch
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(request.resource.data.changeSequence))).data.operationId == request.resource.data.operationId
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(request.resource.data.changeSequence))).data.epoch == getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/meta/head).data.epoch
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/meta/head).data.changeSequence == request.resource.data.changeSequence;
          allow update, delete: if false;
        }

        match /changes/{changeId} {
          allow read: if owns(uid) && validLibrary(remoteLibraryId);
          allow create: if owns(uid)
            && validLibrary(remoteLibraryId)
            && changeId == string(request.resource.data.sequence)
            && changeId == string(getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/meta/head).data.changeSequence)
            && validChange(request.resource.data)
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/meta/head).data.epoch == request.resource.data.epoch
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId)).data.revision == request.resource.data.revision
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId)).data.deleted == request.resource.data.deleted
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId)).data.epoch == request.resource.data.epoch
            && (
              (
                exists(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId))
                && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId)).data.revision == get(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId)).data.revision + 1
              )
              || (
                !exists(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId))
                && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/entities/$(request.resource.data.entityId)).data.revision == 1
              )
            )
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/operations/$(request.resource.data.operationId)).data.entityId == request.resource.data.entityId
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/operations/$(request.resource.data.operationId)).data.revision == request.resource.data.revision
            && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/operations/$(request.resource.data.operationId)).data.changeSequence == request.resource.data.sequence;
          allow update, delete: if false;
        }

        match /meta/{metaId} {
          allow read: if owns(uid) && validLibrary(remoteLibraryId);
          allow write: if metaId == 'head'
            && owns(uid)
            && validLibrary(remoteLibraryId)
            && validHead(request.resource.data)
            && (
              request.method == 'create'
                ? (
                  request.resource.data.changeSequence == 0
                  || request.resource.data.changeSequence == 1
                )
                : request.resource.data.changeSequence == resource.data.changeSequence + 1
            )
            && (
              request.method == 'create'
              || request.resource.data.epoch >= resource.data.epoch
            )
            && (
              request.resource.data.changeSequence == 0
              || (
                existsAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(request.resource.data.changeSequence)))
                && getAfter(/databases/$(database)/documents/users/$(uid)/libraries/$(remoteLibraryId)/changes/$(string(request.resource.data.changeSequence))).data.epoch == request.resource.data.epoch
              )
            );
        }
      }
    }
  }
}
