# Copie para wrangler.toml apenas no staging isolado da V2.
# Não versione account_id, segredos ou o wrangler.toml real.
name = "<staging-worker-name>"
main = "../site-worker.ts"
compatibility_date = "2026-11-17"
# account_id = "<account-id>"

[assets]
directory = "../../dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
# Sem esta regra o fallback SPA captura /__/auth/* e o login quebra.
run_worker_first = ["/__/*"]

[vars]
FIREBASE_PROJECT_ID = "<v2-firebase-project-id>"
