{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estudo-organizado",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "main": "worker/index.js",
  "assets": {
    "directory": "src",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
