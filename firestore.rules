rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validRetaFinalCapabilities(capabilities) {
      return capabilities is map
        && capabilities.keys().hasOnly(['schema', 'granularMerge', 'guards'])
        && capabilities.keys().hasAll(['schema', 'granularMerge', 'guards'])
        && capabilities.schema == 2
        && capabilities.granularMerge == true
        && capabilities.guards is map
        && capabilities.guards.keys().hasOnly(['envelope', 'probe'])
        && capabilities.guards.keys().hasAll(['envelope', 'probe'])
        && capabilities.guards.envelope == 'rules-v2'
        && capabilities.guards.probe == 1;
    }

    function validRetaFinalSyncDescriptor(descriptor) {
      return descriptor is map
        && descriptor.keys().hasOnly([
          'schema',
          'planId',
          'lineageId',
          'generation',
          'revision',
          'baseRevision',
          'snapshotRevision',
          'baseSnapshotRevision',
          'baseRemoteUpdatedAt',
          'digest',
          'deviceId',
          'capabilities',
          'state',
          'minRetainedRevision',
          'removedBlockIds'
        ])
        && descriptor.keys().hasAll([
          'schema',
          'planId',
          'lineageId',
          'generation',
          'revision',
          'baseRevision',
          'snapshotRevision',
          'baseSnapshotRevision',
          'baseRemoteUpdatedAt',
          'digest',
          'deviceId',
          'capabilities',
          'state'
        ])
        && descriptor.schema == 2
        && descriptor.planId is string
        && descriptor.planId.size() > 0
        && descriptor.planId.size() <= 128
        && descriptor.lineageId is string
        && descriptor.lineageId.size() > 0
        && descriptor.lineageId.size() <= 128
        && descriptor.generation is int
        && descriptor.generation >= 1
        && descriptor.revision is int
        && descriptor.revision >= 0
        && descriptor.baseRevision is int
        && descriptor.baseRevision >= 0
        && descriptor.snapshotRevision is int
        && descriptor.snapshotRevision >= 1
        && descriptor.baseSnapshotRevision is int
        && descriptor.baseSnapshotRevision >= 0
        && descriptor.baseSnapshotRevision <= descriptor.snapshotRevision
        && (descriptor.baseRemoteUpdatedAt == null || descriptor.baseRemoteUpdatedAt is string)
        && descriptor.digest is string
        && descriptor.digest.size() >= 16
        && descriptor.digest.size() <= 128
        && descriptor.digest.matches('[a-z0-9]+')
        && descriptor.deviceId is string
        && descriptor.deviceId.size() > 0
        && descriptor.deviceId.size() <= 128
        && validRetaFinalCapabilities(descriptor.capabilities)
        && descriptor.state in ['active', 'retired']
        && (
          !descriptor.keys().hasAny(['minRetainedRevision'])
          || (
            descriptor.minRetainedRevision is int
            && descriptor.minRetainedRevision >= 0
          )
        )
        && (
          !descriptor.keys().hasAny(['removedBlockIds'])
          || (
            descriptor.removedBlockIds is list
            && descriptor.removedBlockIds.size() <= 200
          )
        );
    }

    function validRetaFinalGuard() {
      return request.resource.data.keys().hasOnly(['schema', 'guardVersion', 'deviceId', 'checkedAt'])
        && request.resource.data.keys().hasAll(['schema', 'guardVersion', 'deviceId', 'checkedAt'])
        && request.resource.data.schema == 2
        && request.resource.data.guardVersion == 1
        && request.resource.data.deviceId is string
        && request.resource.data.deviceId.size() > 0
        && request.resource.data.deviceId.size() <= 128
        && request.resource.data.checkedAt is string
        && request.resource.data.checkedAt.size() > 0
        && request.resource.data.checkedAt.size() <= 64;
    }

    function validRetaFinalPayloadState() {
      return request.resource.data.payload is map
        && (
          (
            request.resource.data.retaFinalSync.state == 'active'
            && request.resource.data.payload.keys().hasAny(['planejamento'])
            && request.resource.data.payload.planejamento is map
            && request.resource.data.payload.planejamento.keys().hasAny(['ativo'])
            && request.resource.data.payload.planejamento.ativo == true
            && request.resource.data.payload.planejamento.planId == request.resource.data.retaFinalSync.planId
          )
          || (
            request.resource.data.retaFinalSync.state == 'retired'
            && (
              !request.resource.data.payload.keys().hasAny(['planejamento'])
              || request.resource.data.payload.planejamento == null
              || (
                request.resource.data.payload.planejamento is map
                && (
                  !request.resource.data.payload.planejamento.keys().hasAny(['ativo'])
                  || request.resource.data.payload.planejamento.ativo != true
                )
                && (
                  !request.resource.data.payload.planejamento.keys().hasAny(['planId'])
                  || request.resource.data.payload.planejamento.planId == request.resource.data.retaFinalSync.planId
                )
              )
            )
          )
        );
    }

    function hasRetaFinalSync() {
      return request.resource.data.keys().hasAny(['retaFinalSync']);
    }

    function validRetaFinalSnapshotCreate() {
      return !hasRetaFinalSync()
        || (
          request.resource.data.retaFinalSync.baseRevision == 0
          && request.resource.data.retaFinalSync.snapshotRevision == 1
          && request.resource.data.retaFinalSync.baseSnapshotRevision == 0
          && request.resource.data.retaFinalSync.state == 'active'
        );
    }

    function validRetaFinalSnapshotUpdate() {
      return request.method == 'update'
        && resource != null
        && resource.data != null
        && (
          !resource.data.keys().hasAny(['retaFinalSync'])
          ? (
            !hasRetaFinalSync()
            || (
              request.resource.data.retaFinalSync.baseRevision == 0
              && request.resource.data.retaFinalSync.snapshotRevision == 1
              && request.resource.data.retaFinalSync.baseSnapshotRevision == 0
              && request.resource.data.retaFinalSync.state == 'active'
              && request.resource.data.retaFinalSync.baseRemoteUpdatedAt == resource.data.payloadUpdatedAt
            )
          )
          : (
            hasRetaFinalSync()
            && request.resource.data.retaFinalSync.planId == resource.data.retaFinalSync.planId
            && request.resource.data.retaFinalSync.lineageId == resource.data.retaFinalSync.lineageId
            && request.resource.data.retaFinalSync.generation == resource.data.retaFinalSync.generation
            && (
              (
                request.resource.data.retaFinalSync == resource.data.retaFinalSync
                && request.resource.data.payload == resource.data.payload
                && request.resource.data.payloadUpdatedAt == resource.data.payloadUpdatedAt
              )
              || (
                request.resource.data.retaFinalSync.snapshotRevision == resource.data.retaFinalSync.snapshotRevision + 1
                && request.resource.data.retaFinalSync.baseSnapshotRevision == resource.data.retaFinalSync.snapshotRevision
                && (
                  (
                    request.resource.data.retaFinalSync.revision == resource.data.retaFinalSync.revision
                    && request.resource.data.retaFinalSync.digest == resource.data.retaFinalSync.digest
                    && request.resource.data.retaFinalSync.state == resource.data.retaFinalSync.state
                    && (
                      request.resource.data.payload.keys().hasAny(['planejamento'])
                      == resource.data.payload.keys().hasAny(['planejamento'])
                    )
                    && (
                      !request.resource.data.payload.keys().hasAny(['planejamento'])
                      || request.resource.data.payload.planejamento == resource.data.payload.planejamento
                    )
                    && (
                      !resource.data.retaFinalSync.keys().hasAny(['minRetainedRevision'])
                      ? !request.resource.data.retaFinalSync.keys().hasAny(['minRetainedRevision'])
                      : (
                        request.resource.data.retaFinalSync.keys().hasAny(['minRetainedRevision'])
                        && request.resource.data.retaFinalSync.minRetainedRevision == resource.data.retaFinalSync.minRetainedRevision
                      )
                    )
                    && (
                      !resource.data.retaFinalSync.keys().hasAny(['removedBlockIds'])
                      ? !request.resource.data.retaFinalSync.keys().hasAny(['removedBlockIds'])
                      : (
                        request.resource.data.retaFinalSync.keys().hasAny(['removedBlockIds'])
                        && request.resource.data.retaFinalSync.removedBlockIds == resource.data.retaFinalSync.removedBlockIds
                      )
                    )
                  )
                  || (
                    request.resource.data.retaFinalSync.revision == resource.data.retaFinalSync.revision + 1
                    && request.resource.data.retaFinalSync.baseRevision == resource.data.retaFinalSync.revision
                    && (
                      resource.data.retaFinalSync.state == 'active'
                      || request.resource.data.retaFinalSync.state == 'retired'
                    )
                    && (
                      !resource.data.retaFinalSync.keys().hasAny(['minRetainedRevision'])
                      || (
                        request.resource.data.retaFinalSync.keys().hasAny(['minRetainedRevision'])
                        && request.resource.data.retaFinalSync.minRetainedRevision >= resource.data.retaFinalSync.minRetainedRevision
                      )
                    )
                    && (
                      !resource.data.retaFinalSync.keys().hasAny(['removedBlockIds'])
                      || (
                        request.resource.data.retaFinalSync.keys().hasAny(['removedBlockIds'])
                        && request.resource.data.retaFinalSync.removedBlockIds.hasAll(resource.data.retaFinalSync.removedBlockIds)
                      )
                      || (
                        request.resource.data.retaFinalSync.keys().hasAny(['minRetainedRevision'])
                        && request.resource.data.retaFinalSync.minRetainedRevision >= resource.data.retaFinalSync.revision
                      )
                    )
                  )
                )
              )
            )
          )
        );
    }

    function validSnapshot() {
      return request.resource.data.keys().hasOnly([
        'version',
        'schemaVersion',
        'deviceId',
        'baseRemoteUpdatedAt',
        'payloadUpdatedAt',
        'sentAt',
        'entityManifest',
        'retaFinalSync',
        'payload',
        'updatedAt',
        'serverUpdatedAt'
      ])
      && request.resource.data.version == 1
      && request.resource.data.payload is map
      && request.resource.data.deviceId is string
      && request.resource.data.payloadUpdatedAt is string
      && (
        !request.resource.data.keys().hasAny(['schemaVersion'])
        || request.resource.data.schemaVersion is number
      )
      && (
        !request.resource.data.keys().hasAny(['baseRemoteUpdatedAt'])
        || request.resource.data.baseRemoteUpdatedAt == null
        || request.resource.data.baseRemoteUpdatedAt is string
      )
      && (
        !request.resource.data.keys().hasAny(['sentAt'])
        || request.resource.data.sentAt is string
      )
      && (
        !request.resource.data.keys().hasAny(['updatedAt'])
        || request.resource.data.updatedAt is string
      )
      && (
        !request.resource.data.keys().hasAny(['serverUpdatedAt'])
        || request.resource.data.serverUpdatedAt is timestamp
      )
      && (
        !request.resource.data.keys().hasAny(['entityManifest'])
        || request.resource.data.entityManifest is list
      )
      && (
        !hasRetaFinalSync()
        || (
          validRetaFinalSyncDescriptor(request.resource.data.retaFinalSync)
          && validRetaFinalPayloadState()
        )
      );
    }

    function validEntityDoc() {
      return request.resource.data.keys().hasOnly([
        'version',
        'schemaVersion',
        'key',
        'collection',
        'id',
        'checksum',
        'updatedAt',
        'deletedAt',
        'revision',
        'updatedBy',
        'payload',
        'sentAt',
        'serverUpdatedAt'
      ])
      && request.resource.data.version == 1
      && request.resource.data.key is string
      && request.resource.data.collection is string
      && validEntityCollection()
      && request.resource.data.id is string
      && request.resource.data.revision is number
      && request.resource.data.revision >= 0
      && (
        request.resource.data.payload == null
        || request.resource.data.payload is map
      )
      && (
        !request.resource.data.keys().hasAny(['schemaVersion'])
        || request.resource.data.schemaVersion is number
      )
      && (
        !request.resource.data.keys().hasAny(['checksum'])
        || request.resource.data.checksum == null
        || request.resource.data.checksum is string
      )
      && (
        !request.resource.data.keys().hasAny(['updatedAt'])
        || request.resource.data.updatedAt == null
        || request.resource.data.updatedAt is string
      )
      && (
        !request.resource.data.keys().hasAny(['deletedAt'])
        || request.resource.data.deletedAt == null
        || request.resource.data.deletedAt is string
      )
      && (
        !request.resource.data.keys().hasAny(['updatedBy'])
        || request.resource.data.updatedBy == null
        || request.resource.data.updatedBy is string
      )
      && (
        !request.resource.data.keys().hasAny(['sentAt'])
        || request.resource.data.sentAt is string
      )
      && (
        !request.resource.data.keys().hasAny(['serverUpdatedAt'])
        || request.resource.data.serverUpdatedAt is timestamp
      )
      && validEntityTombstone();
    }

    function validEntityCollection() {
      return request.resource.data.collection in [
        'editais',
        'disciplinas',
        'assuntos',
        'aulas',
        'eventos',
        'arquivo',
        'revisoes',
        'planejamento.sequencia'
      ]
        || request.resource.data.collection in [
          'habitos.questoes',
          'habitos.revisao',
          'habitos.discursiva',
          'habitos.simulado',
          'habitos.leitura',
          'habitos.informativo',
          'habitos.sumula',
          'habitos.videoaula',
          'habitos.paginas'
        ];
    }

    function immutableEntityIdentity() {
      return resource.data.key == request.resource.data.key
        && resource.data.collection == request.resource.data.collection
        && resource.data.id == request.resource.data.id;
    }

    function sameEntityContent() {
      return request.resource.data.payload == resource.data.payload
        && (
          request.resource.data.keys().hasAny(['schemaVersion'])
            ? request.resource.data.schemaVersion
            : null
        ) == (
          resource.data.keys().hasAny(['schemaVersion'])
            ? resource.data.schemaVersion
            : null
        )
        && (
          request.resource.data.keys().hasAny(['checksum'])
            ? request.resource.data.checksum
            : null
        ) == (
          resource.data.keys().hasAny(['checksum'])
            ? resource.data.checksum
            : null
        )
        && (
          request.resource.data.keys().hasAny(['updatedAt'])
            ? request.resource.data.updatedAt
            : null
        ) == (
          resource.data.keys().hasAny(['updatedAt'])
            ? resource.data.updatedAt
            : null
        )
        && (
          request.resource.data.keys().hasAny(['deletedAt'])
            ? request.resource.data.deletedAt
            : null
        ) == (
          resource.data.keys().hasAny(['deletedAt'])
            ? resource.data.deletedAt
            : null
        )
        && (
          request.resource.data.keys().hasAny(['updatedBy'])
            ? request.resource.data.updatedBy
            : null
        ) == (
          resource.data.keys().hasAny(['updatedBy'])
            ? resource.data.updatedBy
            : null
        );
    }

    function validEntityTombstone() {
      return (
        (
          !request.resource.data.keys().hasAny(['deletedAt'])
          || request.resource.data.deletedAt == null
        )
        && request.resource.data.payload is map
      )
      || (
        request.resource.data.deletedAt is string
        && (
          request.resource.data.payload == null
          || (
            request.resource.data.payload is map
            && request.resource.data.payload.keys().hasAny(['deletedAt'])
            && request.resource.data.payload.deletedAt is string
          )
        )
      );
    }

    match /users/{uid}/snapshots/{snapshotId} {
      allow read: if owns(uid);
      allow create: if owns(uid) && snapshotId == 'main'
        && validSnapshot() && validRetaFinalSnapshotCreate();
      allow update: if owns(uid) && snapshotId == 'main'
        && validSnapshot() && validRetaFinalSnapshotUpdate();
      allow delete: if false;
    }

    match /users/{uid}/syncMeta/{metaId} {
      allow read: if owns(uid) && metaId == 'reta-final-guard';
      allow create, update: if owns(uid) && metaId == 'reta-final-guard' && validRetaFinalGuard();
      allow delete: if false;
    }

    match /users/{uid}/entities/{entityId} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validEntityDoc();
      allow update: if owns(uid) && validEntityDoc() && immutableEntityIdentity()
        && (
          request.resource.data.revision > resource.data.revision
          || (
            request.resource.data.revision == resource.data.revision
            && sameEntityContent()
          )
        );
      allow delete: if false;
    }

    // V1 namespace root is the Admin migration manifest. Only Admin writes the
    // pointer or manifest. An operation receipt mirrors the entity minus data.
    match /users/{uid}/v1SyncControl/current {
      allow get: if owns(uid);
    }

    match /users/{uid}/v1SyncNamespaces/{generation} {
      function active() {
        let control = get(/databases/$(database)/documents/users/$(uid)/v1SyncControl/current).data;
        let manifest = get(/databases/$(database)/documents/users/$(uid)/v1SyncNamespaces/$(generation)).data;
        return control.schemaVersion == 1 && control.generationId == generation
          && manifest.schemaVersion == 1 && manifest.generationId == generation && manifest.state == 'active';
      }
      function knownCollection(c) {
        return c in ['editais', 'disciplinas', 'eventos', 'habitos', 'retaFinalBlocos', 'meta', 'tombstones'];
      }
      function typeMatches(c, t) {
        return t is string && t.toUtf8().size() <= 128 && (
          (c == 'editais' && t == 'edital') || (c == 'disciplinas' && t == 'disciplina')
          || (c == 'eventos' && t == 'evento') || (c == 'retaFinalBlocos' && t == 'retaFinalBloco')
          || (c == 'meta' && t == 'meta') || (c == 'habitos' && t.matches('habito[.][^:]+'))
          || (c == 'tombstones' && t.matches('tombstone[.](syncTombstones|config[.]entityTombstones)[.][^:]+')));
      }
      function token(s) {
        return s is string && s.matches('[A-Za-z0-9][A-Za-z0-9_-]{0,127}');
      }
      function documentId(d) {
        return (d.entityType + ':' + d.entityId).toUtf8().toHexString().lower();
      }
      function validEntity(d, c, id) {
        return d.keys().hasOnly(['schemaVersion', 'generationId', 'collection', 'entityType', 'entityId',
          'baseRevision', 'revision', 'opId', 'opDigest', 'deleted', 'data', 'updatedAt'])
          && d.schemaVersion is int && d.schemaVersion == 1 && d.generationId == generation && token(generation)
          && d.collection == c && typeMatches(c, d.entityType) && d.entityId is string
          && d.entityId.size() > 0 && d.entityId.size() <= 750 && documentId(d) == id
          && d.baseRevision is int && d.baseRevision >= 0 && d.revision is int
          && d.revision <= 9007199254740991 && d.revision == d.baseRevision + 1
          && token(d.opId) && d.updatedAt == request.time && d.deleted is bool
          && (d.deleted ? d.data == null && d.baseRevision > 0 :
            d.data is string && d.data.size() > 0 && d.data.toUtf8().size() <= 921600)
          && d.opDigest == hashing.sha256(d.deleted ? 'null' : d.data).toHexString().lower();
      }
      function receiptPath(op) {
        return /databases/$(database)/documents/users/$(uid)/v1SyncNamespaces/$(generation)/operations/$(op);
      }
      function mirrors(entity, receipt) {
        return !receipt.keys().hasAny(['data']) && entity.diff(receipt).affectedKeys().hasOnly(['data']);
      }
      function freshReceipt(d) {
        let path = receiptPath(d.opId);
        return !exists(path) && mirrors(d, getAfter(path).data);
      }
      function entityAdvanced(r) {
        let c = r.collection;
        let id = documentId(r);
        let path = /databases/$(database)/documents/users/$(uid)/v1SyncNamespaces/$(generation)/$(c)/$(id);
        return (exists(path) ? get(path).data.revision == r.baseRevision : r.baseRevision == 0)
          && r.revision == r.baseRevision + 1 && mirrors(getAfter(path).data, r);
      }

      allow get: if owns(uid) && active();
      match /{c}/{id} {
        allow read: if owns(uid) && knownCollection(c) && active();
        allow create: if owns(uid) && knownCollection(c) && active()
          && validEntity(request.resource.data, c, id) && request.resource.data.baseRevision == 0
          && freshReceipt(request.resource.data);
        allow update: if owns(uid) && knownCollection(c) && active()
          && validEntity(request.resource.data, c, id) && resource.data.deleted == false
          && request.resource.data.baseRevision == resource.data.revision
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['schemaVersion', 'generationId', 'collection', 'entityType', 'entityId'])
          && freshReceipt(request.resource.data);
      }
      match /operations/{op} {
        allow read: if owns(uid) && active();
        allow create: if owns(uid) && active() && request.resource.data.opId == op && token(op)
          && typeMatches(request.resource.data.collection, request.resource.data.entityType)
          && entityAdvanced(request.resource.data);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
